#!/usr/bin/env bash
set -euo pipefail

data_dir="${APP_DATA_DIR:-/data}"

exec_as_app() {
  if [[ "$(id -u)" = "0" ]]; then
    exec gosu app "$@"
  fi

  exec "$@"
}

case "${1:-}" in
  config|healthcheck|--help|-h)
    exec_as_app /app/bin/cyder-music "$@"
    ;;
esac

prepare_directory() {
  local directory="$1"

  if [[ -e "$directory" && ! -d "$directory" ]]; then
    echo "container directory path exists but is not a directory: $directory" >&2
    exit 1
  fi

  if [[ ! -d "$directory" ]]; then
    if [[ "$(id -u)" = "0" ]]; then
      install -d -m 0755 -o app -g app "$directory"
    else
      mkdir -p "$directory"
    fi
  fi
}

prepare_directory "$data_dir"
prepare_directory "$data_dir/config"
prepare_directory "$data_dir/db"
prepare_directory "$data_dir/storage"
prepare_directory "$data_dir/logs"
prepare_directory "/tmp/cyder-music"

exec_as_app "$@"
